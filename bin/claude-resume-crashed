#!/usr/bin/env bash
# Reopens every Claude Code session that is registered as live but whose
# process no longer exists (PC crash, reboot, dead desktop session, killed terminal).
# Each session gets its own gnome-terminal window in its original directory.
#
#   claude-resume-crashed              reopen crashed sessions and tell them to carry on
#   claude-resume-crashed --list       only show what would be reopened
#   claude-resume-crashed --prompt T   send prompt T instead of the default one
#   claude-resume-crashed --no-prompt  reopen at the input line, send nothing
set -euo pipefail

registry="$HOME/.claude/live-sessions"
log_file="${XDG_STATE_HOME:-$HOME/.local/state}/claude-revive/resume.log"
# Seconds between two reopened windows: every resumed head starts working at
# once, and five of them in the same second overbook the machine.
launch_gap_seconds=5
list_only=false
prompt="Der Rechner ist abgestürzt, diese Session wurde automatisch wiederhergestellt. Fasse in zwei Sätzen zusammen, wo du standst, und mach dann dort weiter."

while [ $# -gt 0 ]; do
  case "$1" in
    --list) list_only=true ;;
    --prompt) prompt="$2"; shift ;;
    --no-prompt) prompt="" ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

current_boot_id=$(cat /proc/sys/kernel/random/boot_id)

crashed_sessions() {
  python3 - "$registry" "$current_boot_id" <<'PY'
import json, os, sys
registry, current_boot_id = sys.argv[1], sys.argv[2]
if not os.path.isdir(registry):
    sys.exit(0)

def process_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

for name in sorted(os.listdir(registry)):
    path = os.path.join(registry, name)
    with open(path) as f:
        record = json.load(f)
    same_boot = record["bootId"] == current_boot_id
    if same_boot and process_alive(record["pid"]):
        continue
    print(f'{path}\t{record["sessionId"]}\t{record["cwd"]}')
PY
}

# A resumed session must be a top-level session again. When this script runs
# inside a Claude session (a Bash tool call), the CLAUDE_* variables would turn
# every reopened session into a child of that session: no transcript of its own,
# nothing persisted. Strip them before launching.
open_terminal() {
  local cwd="$1"; shift
  env $(env | grep -oE '^CLAUDE[A-Z0-9_]*' | sed 's/^/-u /') \
    gnome-terminal --title="claude: $(basename "$cwd")" --working-directory="$cwd" -- "$@"
}

log() {
  echo "$*"
  $list_only && return
  mkdir -p "$(dirname "$log_file")"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$log_file"
}

notify() {
  command -v notify-send > /dev/null || return 0
  notify-send --app-name="Claude Code" "$1" "$2" 2> /dev/null || true
}

found=0
resumed=0
while IFS=$'\t' read -r entry session_id cwd; do
  found=$((found + 1))
  if $list_only; then
    echo "$session_id  $cwd"
    continue
  fi
  if [ ! -d "$cwd" ]; then
    log "skip $session_id: directory $cwd is gone"
    rm -f "$entry"
    continue
  fi
  [ "$resumed" -gt 0 ] && sleep "$launch_gap_seconds"
  log "resuming $session_id in $cwd"
  # The resumed session re-registers itself via the SessionStart hook,
  # so the crashed entry is dropped here to avoid a second resume later.
  rm -f "$entry"
  if [ -n "$prompt" ]; then
    open_terminal "$cwd" claude --resume "$session_id" "$prompt"
  else
    open_terminal "$cwd" claude --resume "$session_id"
  fi
  resumed=$((resumed + 1))
done < <(crashed_sessions)

if $list_only; then
  [ "$found" -eq 0 ] && echo "no crashed sessions"
elif [ "$resumed" -gt 0 ]; then
  notify "Claude Code sessions restored" "$resumed session(s) reopened, see $log_file"
else
  log "no crashed sessions"
  notify "Claude Code" "No crashed sessions to restore"
fi
