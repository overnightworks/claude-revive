#!/usr/bin/env bash
# Claude Code hook: records every running interactive top-level session so that
# claude-resume-crashed can reopen the ones that never ended (PC crash,
# dead desktop session, killed terminal).
# Registry: ~/.claude/live-sessions/<claude-pid>.json, one file per claude process.
#
# Configured in ~/.claude/settings.json as
#   SessionStart: claude-session-registry start $PPID
#   SessionEnd:   claude-session-registry end $PPID
# The hook shell's $PPID is the claude process; this script itself is one
# level deeper, so the pid has to be handed in.
#
# Everything is judged from the claude process itself (/proc/<pid>), never from
# this hook's environment: Claude Code marks every process it spawns, hooks
# included, as CLAUDE_CODE_CHILD_SESSION, so the hook's own variables say
# nothing about the session.
set -euo pipefail

usage() {
  echo "usage: claude-session-registry start|end CLAUDE_PID  (reads hook JSON on stdin)" >&2
  exit 2
}

[ $# -eq 2 ] || usage
action="$1"
claude_pid="$2"
registry="$HOME/.claude/live-sessions"
entry="$registry/$claude_pid.json"

# A session spawned by another Claude session (subagent, `claude -p` lane,
# anything started from a Bash tool) belongs to its parent: it writes no
# transcript of its own and must never be reopened as a window.
is_child_session() {
  tr '\0' '\n' < "/proc/$claude_pid/environ" 2> /dev/null | grep -q '^CLAUDE_CODE_CHILD_SESSION='
}

terminal_of() {
  local device
  device="$(readlink "/proc/$claude_pid/fd/0" 2> /dev/null || true)"
  case "$device" in
    /dev/pts/*|/dev/tty*) echo "$device" ;;
  esac
}

# A hung-up pty (its terminal is gone) refuses to be opened; a live one does not.
terminal_alive() {
  local device="$1"
  [ -n "$device" ] && { : >> "$device"; } 2> /dev/null
}

hook_event="$(cat)"

case "$action" in
  start)
    if is_child_session; then
      # Tell the person at once, so a window opened by mistake from inside a
      # session (as happened on 2026-09-03) is noticed now, not days later.
      printf '%s\n' '{"systemMessage": "claude-revive: this session was started from inside another Claude session (CLAUDE_CODE_CHILD_SESSION). It writes no transcript of its own, cannot be resumed and is not tracked for crash recovery. For real work, exit and start claude from a plain terminal."}'
      exit 0
    fi
    [ -n "$(terminal_of)" ] || exit 0
    mkdir -p "$registry"
    HOOK_EVENT="$hook_event" python3 - "$entry" "$claude_pid" <<'PY'
import json, os, sys
entry_path, pid = sys.argv[1], int(sys.argv[2])
event = json.loads(os.environ["HOOK_EVENT"])
with open("/proc/sys/kernel/random/boot_id") as f:
    boot_id = f.read().strip()
record = {
    "pid": pid,
    "bootId": boot_id,
    "sessionId": event["session_id"],
    "cwd": event["cwd"],
}
# A session resumed by hand supersedes its crashed predecessor; without this
# the next login would open the same conversation a second time.
registry = os.path.dirname(entry_path)
for name in os.listdir(registry):
    path = os.path.join(registry, name)
    if path == entry_path:
        continue
    with open(path) as f:
        if json.load(f)["sessionId"] == record["sessionId"]:
            os.remove(path)
with open(entry_path, "w") as f:
    json.dump(record, f)
PY
    ;;
  end)
    # SessionEnd fires for /exit and Ctrl+C, but also when the terminal dies
    # under Claude (desktop session gone, window killed); the reported reason
    # does not tell them apart. The terminal does: if it is still alive the
    # end was wanted, otherwise the entry stays and the next login reopens it.
    if terminal_alive "$(terminal_of)"; then
      rm -f "$entry"
    fi
    ;;
  *)
    usage
    ;;
esac
