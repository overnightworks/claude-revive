#!/usr/bin/env bash
# Claude Code hook: records every running top-level session so that
# claude-resume-crashed can reopen the ones that never ended (PC crash,
# dead desktop session, killed terminal).
# Registry: ~/.claude/live-sessions/<claude-pid>.json, one file per claude process.
#
# Configured in ~/.claude/settings.json as
#   SessionStart: claude-session-registry start $PPID
#   SessionEnd:   claude-session-registry end $PPID
# The hook shell's $PPID is the claude process; this script itself is one
# level deeper, so the pid has to be handed in.
set -euo pipefail

usage() {
  echo "usage: claude-session-registry start|end CLAUDE_PID  (reads hook JSON on stdin)" >&2
  exit 2
}

[ $# -eq 2 ] || usage
action="$1"
claude_pid="$2"
registry="$HOME/.claude/live-sessions"
entry="$registry/$claude_pid.json"

# Sessions spawned by another Claude session (subagents, `claude -p` lanes,
# anything started from a Bash tool) belong to their parent: they write no
# transcript of their own and must never be reopened as a window.
# On start the person gets told, so a window opened by mistake from inside a
# session (as happened on 2026-09-03) is noticed at once, not days later.
if [ -n "${CLAUDE_CODE_CHILD_SESSION:-}" ]; then
  cat > /dev/null
  if [ "$action" = start ]; then
    printf '%s\n' '{"systemMessage": "claude-revive: this session was started from inside another Claude session (CLAUDE_CODE_CHILD_SESSION). It writes no transcript of its own, cannot be resumed and is not tracked for crash recovery. For real work, exit and start claude from a plain terminal."}'
  fi
  exit 0
fi

case "$action" in
  start)
    mkdir -p "$registry"
    # The hook event arrives on stdin; python's own script comes from the heredoc,
    # so the event is handed over through the environment.
    HOOK_EVENT="$(cat)" python3 - "$entry" "$claude_pid" <<'PY'
import json, os, sys
entry_path, pid = sys.argv[1], int(sys.argv[2])
event = json.loads(os.environ["HOOK_EVENT"])
with open("/proc/sys/kernel/random/boot_id") as f:
    boot_id = f.read().strip()
record = {
    "pid": pid,
    "bootId": boot_id,
    "sessionId": event["session_id"],
    "cwd": event["cwd"],
}
with open(entry_path, "w") as f:
    json.dump(record, f)
PY
    ;;
  end)
    # SessionEnd also fires when the terminal dies under Claude (desktop session
    # gone, window killed). Only an end the person asked for drops the entry;
    # every other reason keeps it, so the next login reopens the session.
    reason="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("reason", ""))')"
    case "$reason" in
      clear|logout|prompt_input_exit) rm -f "$entry" ;;
    esac
    ;;
  *)
    usage
    ;;
esac
